                          },
                          "title": {
                            "type": "string"
                          },
                          "author": {
                            "type": "string"
                          },
                          "collection": {
                            "type": "string"
                          },
                          "notice": {
                            "type": "string"
                          },
                          "excerpt": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求失败，见 error.code 与 error.message",
